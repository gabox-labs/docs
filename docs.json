{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Gabox",
  "description": "Clear rules for Gabox packs, randomness, fees, the transfer fee and graduation on Solana.",
  "colors": {
    "primary": "#C7F43A",
    "light": "#DBFF6B",
    "dark": "#95C000"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "dark": "#0C0E0C"
    }
  },
  "fonts": {
    "heading": {
      "family": "Sora",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "icon": "globe",
          "href": "https://gabox.fun"
        },
        {
          "anchor": "App",
          "icon": "rocket",
          "href": "https://gabox.fun/login"
        },
        {
          "anchor": "X",
          "icon": "x-twitter",
          "href": "https://x.com/Gabox_fun"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "how-it-works",
              "parties-and-rules",
              "glossary"
            ]
          },
          {
            "group": "Open packs",
            "pages": [
              "opening-a-pack",
              "gift-packs",
              "what-a-pack-costs",
              "prizes-and-odds",
              "provable-fairness",
              "keep-or-sell",
              "if-the-draw-is-late"
            ]
          },
          {
            "group": "Create machines",
            "pages": [
              "launch-a-machine",
              "seed-and-jackpot",
              "transfer-fee-and-graduation",
              "referrals-and-earnings"
            ]
          },
          {
            "group": "Safety",
            "pages": [
              "always-funded",
              "risks",
              "trust-boundaries",
              "status-and-addresses"
            ]
          },
          {
            "group": "Legal",
            "pages": [
              "terms"
            ]
          },
          {
            "group": "Brand",
            "pages": [
              "brand-kit"
            ]
          }
        ]
      },
      {
        "tab": "Developer",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "developer/overview",
              "developer/agent-skill",
              "developer/requests-and-answers",
              "developer/limits-and-errors",
              "developer/common-tasks"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "developer/machines",
              "developer/draws",
              "developer/pulls",
              "developer/stats-and-program"
            ]
          },
          {
            "group": "Coming next",
            "pages": [
              "developer/preview-calls"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/gabox-logo-light.svg",
    "dark": "/logo/gabox-logo-dark.svg"
  },
  "footer": {
    "socials": {
      "x": "https://x.com/Gabox_fun",
      "website": "https://gabox.fun"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "Gabox docs"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "mcp"
    ]
  },
  "redirects": [
    {
      "source": "/developer/accounts",
      "destination": "/developer/overview"
    },
    {
      "source": "/developer/instructions",
      "destination": "/developer/overview"
    },
    {
      "source": "/developer/events",
      "destination": "/developer/overview"
    },
    {
      "source": "/hook-and-graduation",
      "destination": "/transfer-fee-and-graduation"
    },
    {
      "source": "/mega-pack",
      "destination": "/status-and-addresses"
    },
    {
      "source": "/machine-recharge",
      "destination": "/status-and-addresses"
    },
    {
      "source": "/fan-coin-machines",
      "destination": "/status-and-addresses"
    },
    {
      "source": "/developer/mega-pack",
      "destination": "/developer/overview"
    }
  ]
}
