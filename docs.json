{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Gabox",
  "description": "Clear rules for Gabox packs, randomness, fees and graduation on Solana.",
  "colors": {
    "primary": "#C7F43A",
    "light": "#DBFF6B",
    "dark": "#95C000"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "dark": "#0C0E0C"
    }
  },
  "fonts": {
    "heading": {
      "family": "Sora",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "how-it-works",
          "parties-and-rules",
          "glossary"
        ]
      },
      {
        "group": "Open packs",
        "pages": [
          "opening-a-pack",
          "what-a-pack-costs",
          "prizes-and-odds",
          "provable-fairness",
          "keep-or-sell",
          "if-the-draw-is-late"
        ]
      },
      {
        "group": "Create machines",
        "pages": [
          "launch-a-machine",
          "seed-and-jackpot",
          "hook-and-graduation",
          "referrals-and-earnings"
        ]
      },
      {
        "group": "Safety",
        "pages": [
          "always-funded",
          "risks",
          "trust-boundaries"
        ]
      },
      {
        "group": "Developers",
        "pages": [
          "architecture",
          "the-math",
          "build-on-gabox",
          "status-and-addresses"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/gabox-logo-light.svg",
    "dark": "/logo/gabox-logo-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact",
        "href": "mailto:hello@gabox.fun"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch app",
      "href": "https://gabox.fun"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/Gabox_fun",
      "website": "https://gabox.fun"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "Gabox docs"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "mcp"
    ]
  }
}
